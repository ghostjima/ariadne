{
  "name": "@ariadne/grid",
  "version": "0.1.0",
  "description": "Data engine for a complaints register: a seeded synthetic corpus with legal deadlines from ariadne-rules, a columnar store, filters with facets, views, roles, validated edits with undo, a simulated colleague and CSV export",
  "type": "module",
  "license": "MIT OR Apache-2.0",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "./dist/worker/entry.js"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./worker": {
      "types": "./dist/worker/entry.d.ts",
      "default": "./dist/worker/entry.js"
    },
    "./pools/en": {
      "types": "./dist/pools/en.d.ts",
      "default": "./dist/pools/en.js"
    },
    "./pools/ru": {
      "types": "./dist/pools/ru.d.ts",
      "default": "./dist/pools/ru.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "measure": "pnpm build && node bench/measure.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "typescript": "6.0.3",
    "vitest": "5.0.2"
  },
  "dependencies": {
    "@ariadne/rules": "workspace:*"
  }
}
